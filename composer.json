{
    "name": "symsvel-framework/module-tracking",
    "description": "SymSvel module Tracking",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.1",
        "doctrine/dbal": "^4.0",
        "symsvel-framework/module-acls": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SymSvel\\Module\\Tracking\\": "back/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymSvel\\Module\\Tracking\\Tests\\": "back/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "doctrine/migrations": "^3.9"
    },
    "scripts": {
        "test": "phpunit -c back/phpunit.xml.dist",
        "qa": [
            "@test"
        ]
    },
    "extra": {
        "symsvel-module": {
            "manifest": "module.json"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Symsvel-Framework/symsvel-module-acls.git"
        }
    ]
}
